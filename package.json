{
  "name": "personal-universe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"api,app\" -c \"magenta,cyan\" \"tsx server/index.ts\" \"vite\"",
    "dev:frontend": "vite",
    "dev:worker": "wrangler dev",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "build:worker": "wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply personal_universe_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal_universe_db --remote",
    "db:seed": "node scripts/generate-seed.cjs",
    "media:migrate:local": "node scripts/migrate-media-to-cloudinary.cjs",
    "media:migrate:remote": "node scripts/migrate-media-to-cloudinary.cjs --remote",
    "test:worker": "node scripts/test-cloudflare-worker.cjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^14.12.0",
    "hono": "^4.13.18",
    "lucide-react": "^1.71.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.1.2",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.162.0"
  }
}
