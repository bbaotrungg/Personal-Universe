# OWNER ACCESS CODE (Mã truy cập dành riêng cho chủ sở hữu)
OWNER_ACCESS_CODE=universe2026

# Server Port
PORT=3001

# Public Base URL (Dùng để tạo mã QR cố định, ví dụ: https://domain-cua-ban.com/bao-trung)
PUBLIC_SITE_URL=http://localhost:5173

# Cloudinary Free (Lưu trữ ảnh & MP3 không giới hạn thời gian trên gói Free)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
